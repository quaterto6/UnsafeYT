{
  "manifest_version": 3,
  "name": "UnsafeYT",
  "version": "1.0.0",
  "description": "Decrypt unsafe videos",
  "permissions": ["tabs", "scripting"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "http://0.0.0.0:2000/*",
        "http://localhost:2000/*"
      ],
      "js": ["jquery.js", "background.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shaders/screen.frag",
        "shaders/screen.vrt"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
